# Copy to .env.local for local overrides. Nothing here is required for local development.

# Postgres connection string. Leave unset locally to use the embedded database in ./.data
# Required on Railway / Vercel / any cloud host.
# DATABASE_URL=postgres://user:password@host:5432/mizan

# Max connections per app instance (default 5). Keep low on Vercel.
# DATABASE_POOL_SIZE=5

# Business timezone for "today", lateness and reports (default Asia/Tehran).
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Tehran
